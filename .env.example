# ===== Scuarfy Store — пример конфигурации =====
# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env

# Google OAuth (необязательно). Credentials из Google Cloud Console,
# тип «Web application». Оставьте пустыми, чтобы использовать локальную регистрацию.
GOOGLE_CLIENT_ID=

# Client Secret той же OAuth-credentials (Google Cloud Console → Credentials →
# OAuth 2.0 Client IDs → Web application). Используется для обмена авторизационного
# кода на токены и для настроек /api/auth/config. Не публикуйте этот файл в git!
GOOGLE_CLIENT_SECRET=

# Секретный ключ для подписи сессий Flask. Сгенерируйте случайную строку,
# например:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string

# Режим отладки Flask (True только для разработки!)
FLASK_DEBUG=False

# Время жизни сессии пользователя, в часах
SESSION_LIFETIME_HOURS=72

# Хост и порт для запуска сервера разработки
HOST=127.0.0.1
PORT=5000

# Максимальный размер загружаемого файла приложения, в МБ
MAX_APP_SIZE_MB=300

# Разрешить демо-вход без Google (/api/auth/demo) — True/False.
# На продакшене рекомендуется False.
DEMO_LOGIN=True

# Пароль для активации прав администратора на секретной странице /admin_streaker.
# Если оставить пустым — пароль будет установлен при первом вводе на этой странице.
# Для продакшена задайте надёжный пароль здесь, чтобы никто другой не смог его задать первым.
ADMIN_PASSWORD=

# --- Termux (Android) ---
# На телефоне запускайте: python app.py  (google-auth/cryptography ставить не нужно —
# приложение само использует встроенную pure-python проверку подписи Google-токена).
# Чтобы открыть магазин с другого устройства в Wi-Fi сети:
# HOST=0.0.0.0
# PORT=5000

# --- ИИ-помощник (Pollinations) ---
# Необязательно: без ключа используется публичный бесплатный режим.
POLLINATIONS_API_KEY=
# Модель: openai, mistral, llama-fast и др. (список: https://text.pollinations.ai/models)
POLLINATIONS_MODEL=openai
# Базовый URL сервиса (эндпоинт /chat устарел — код сам использует /openai)
POLLINATIONS_URL=https://text.pollinations.ai
# Локальный фолбэк через Ollama (удобно на Termux): 1/true чтобы включить
OLLAMA_FALLBACK=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
