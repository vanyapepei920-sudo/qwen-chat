# ── Синтеко Лаб · Speedtest-портал ─────────────────────────────
# Скопируйте в .env и заполните значения.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ──
# Создайте "OAuth client ID" типа Web application,
# Authorized redirect URI: http://localhost:5000/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Опционально: пускать только эти email-адреса через запятую (пусто = все)
ALLOWED_EMAILS=

# ── Speedtest ──
DOWNLOAD_TEST_MB=25
HISTORY_FILE=results.json

# ── Опционально: поиск через Google Custom Search API ──
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
