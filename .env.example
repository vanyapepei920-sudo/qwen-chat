# ============ NetPulse — шаблон конфигурации ============
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env НЕ коммитится на GitHub — все секреты живут только в нём.

# --- Google OAuth (вход через Google) ---
# Создайте OAuth Client ID: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=ВСТАВЬ_СЮДА.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-ВСТАВЬ_СЮДА

# --- Поиск Google (Custom Search JSON API, опционально) ---
# API key: https://console.cloud.google.com/apis/credentials
# cx:      https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=AIzaSy-ВСТАВЬ_СЮДА
GOOGLE_SEARCH_CX=ВСТАВЬ_СЮДА

# --- Flask ---
FLASK_SECRET_KEY=ВСТАВЬ_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ
FLASK_DEBUG=False
SESSION_LIFETIME_HOURS=24
HOST=127.0.0.1
PORT=5000

# --- уведомления (необязательно) ---
# Любой webhook: Discord (".../slack/webhook/..." для красивого вида), Slack и т.п.
WEBHOOK_URL=
# Telegram-бот: токен от @BotFather + ваш chat_id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
